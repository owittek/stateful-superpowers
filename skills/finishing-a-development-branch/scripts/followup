#!/usr/bin/env bash
# Keep the repo's follow-up list: things noticed mid-task that are out of the
# current step but not worth losing. Any skill notes one with `add` and keeps
# working; finishing's follow-up sort lists the branch's open items and closes
# each as done now, dropped, or deferred to a ticket.
#
# One list per repository, at <main checkout>/.superpowers/followups.md,
# found from any linked worktree through `git rev-parse --git-common-dir`.
# It lives in the main checkout, not the worktree, so items survive worktree
# removal, and in the working tree rather than under .git/ so the
# session-start hook can count `- [ ]` lines with shell builtins and agents
# may write it (Claude Code denies agent writes under .git/). A self-ignoring
# .gitignore at .superpowers/ keeps it out of `git status` without touching
# any tracked file; it is create-only, so a repo's own rule there wins.
#
# Line format, one item per line, never deleted:
#   - [ ] N. [branch] text (source)
#   - [x] N. [branch] text (source) → now|dropped|REF
# " (source)" is omitted when add had no --source. N is max(N in file) + 1,
# and closed lines stay, so a number is never reused. Each item is tagged
# with the branch checked out where it was added; `list` shows the current
# branch's items unless --all, and `count` counts open items on every branch.
# A branch whose worktree is gone keeps its items until they are closed.
#
# -C DIR runs as if started in DIR, the way git -C does (see sdd-workspace).
#
# Usage:
#   followup [-C DIR] add TEXT [--source S]          -> prints N
#   followup [-C DIR] list [--open] [--all]          -> item lines
#   followup [-C DIR] done N --as now|dropped|ticket REF
#   followup [-C DIR] count                          -> open items, all branches
set -euo pipefail

usage() {
  {
    echo "usage: followup [-C DIR] add TEXT [--source S]"
    echo "       followup [-C DIR] list [--open] [--all]"
    echo "       followup [-C DIR] done N --as now|dropped|ticket REF"
    echo "       followup [-C DIR] count"
  } >&2
  exit 2
}

die() {
  echo "followup: $*" >&2
  exit 1
}

# single_line WHAT VALUE -> refuse an empty or multi-line field: each item is
# exactly one line of the file
single_line() {
  [ -n "$2" ] || die "$1 must not be empty"
  case "$2" in
    *$'\n'* | *$'\r'*) die "$1 must be a single line" ;;
  esac
}

# --- shared helpers ---

# Sets LIST (the list file) and DIR (its .superpowers directory) for the
# repository the current directory belongs to.
resolve_list() {
  local common main said
  if ! common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    said=$(git rev-parse --git-common-dir 2>&1 >/dev/null) || true
    die "not inside a git work tree ($PWD): ${said%%$'\n'*}"
  fi
  [ "$(basename "$common")" = .git ] \
    || die "cannot locate the main checkout: git common dir $common is not a .git directory"
  main=$(dirname "$common")
  DIR="$main/.superpowers"
  LIST="$DIR/followups.md"
}

# current_branch -> the short name of the checked-out branch; refuses on a
# detached HEAD, which has no branch to tag an item with
current_branch() {
  local branch
  branch=$(git symbolic-ref --short -q HEAD) \
    || die "detached HEAD: check out a branch to tag follow-ups with"
  printf '%s\n' "$branch"
}

ensure_dir() {
  mkdir -p "$DIR"
  [ -e "$DIR/.gitignore" ] || printf '*\n' >"$DIR/.gitignore"
}

# max_number -> the largest item number in the list, 0 when none
max_number() {
  if [ -f "$LIST" ]; then
    awk '/^- \[[ x]\] [0-9]+\. / { n = substr($0, 7) + 0; if (n > max) max = n }
         END { print max + 0 }' "$LIST"
  else
    echo 0
  fi
}

# --- ops ---

op_add() {
  local text="" source="" branch n line
  [ $# -ge 1 ] || usage
  text=$1
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --source)
        [ $# -ge 2 ] || usage
        source=$2
        single_line "source" "$source"
        shift 2
        ;;
      *) usage ;;
    esac
  done
  single_line "follow-up text" "$text"
  resolve_list
  branch=$(current_branch)
  ensure_dir
  n=$(($(max_number) + 1))
  line="- [ ] $n. [$branch] $text"
  [ -z "$source" ] || line="$line ($source)"
  printf '%s\n' "$line" >>"$LIST"
  printf '%s\n' "$n"
}

op_list() {
  local open=false all=false branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --open) open=true ;;
      --all) all=true ;;
      *) usage ;;
    esac
    shift
  done
  resolve_list
  [ "$all" = true ] || branch=$(current_branch)
  [ -f "$LIST" ] || return 0
  # Match on the exact "] [branch] " tag after the number, so branch feat
  # never shows feat-x's items and text cannot fake a tag.
  awk -v open="$open" -v branch="$branch" '
    !/^- \[[ x]\] [0-9]+\. \[/ { next }
    open == "true" && substr($0, 1, 6) != "- [ ] " { next }
    branch != "" {
      rest = substr($0, 7); sub(/^[0-9]+\. /, "", rest)
      tag = "[" branch "] "
      if (substr(rest, 1, length(tag)) != tag) next
    }
    { print }
  ' "$LIST"
}

op_count() {
  [ $# -eq 0 ] || usage
  resolve_list
  if [ -f "$LIST" ]; then
    awk '/^- \[ \] [0-9]+\. / { n++ } END { print n + 0 }' "$LIST"
  else
    echo 0
  fi
}

# --- dispatch ---

if [ "${1:-}" = "-C" ]; then
  [ -d "${2:-}" ] || { echo "bad -C directory: ${2:-}" >&2; exit 2; }
  cd "$2"
  shift 2
fi

[ $# -ge 1 ] || usage
op=$1
shift
case "$op" in
  add) op_add "$@" ;;
  list) op_list "$@" ;;
  count) op_count "$@" ;;
  *) usage ;;
esac
