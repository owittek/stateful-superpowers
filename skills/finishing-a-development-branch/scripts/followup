#!/usr/bin/env bash
# Keep the repo's follow-up list: things noticed mid-task that are out of the
# current step but not worth losing. Any skill notes one with `add` and keeps
# working; finishing's follow-up sort lists the branch's open items and closes
# each as done now, dropped, or deferred to a ticket.
#
# One list per repository, at <main checkout>/.superpowers/followups.md,
# found from any linked worktree through `git rev-parse --git-common-dir`.
# It lives in the main checkout, not the worktree, so items survive worktree
# removal, and in the working tree rather than under .git/ so the
# session-start hook can count `- [ ]` lines with shell builtins and agents
# may write it (Claude Code denies agent writes under .git/). A self-ignoring
# .gitignore at .superpowers/ keeps it out of `git status` without touching
# any tracked file; it is create-only, so a repo's own rule there wins.
#
# Line format, one item per line, never deleted:
#   - [ ] N. [branch] text (source)
#   - [x] N. [branch] text (source) → now|dropped|REF
# " (source)" is omitted when add had no --source. N is max(N in file) + 1,
# and closed lines stay, so a number is never reused. Each item is tagged
# with the branch checked out where it was added; `list` shows the current
# branch's items unless --all, and `count` counts open items on every branch.
# A branch whose worktree is gone keeps its items until they are closed;
# `list --orphaned` adds the items of branches that no longer exist locally,
# so a branch merged without finishing still gets its items sorted.
# `keep N` re-tags an open item [*] — a kept follow-up, which outlives its
# branch: `*` is not a valid branch name, so no branch's `list` shows it and
# --orphaned never does. `list --kept` prints the open kept items.
#
# -C DIR runs as if started in DIR, the way git -C does (see sdd-workspace).
#
# Usage:
#   followup [-C DIR] add TEXT [--source S]          -> prints N
#   followup [-C DIR] list [--open] [--all] [--orphaned] -> item lines
#   followup [-C DIR] list --kept                    -> open kept items
#   followup [-C DIR] done N --as now|dropped|ticket REF
#   followup [-C DIR] keep N
#   followup [-C DIR] count                          -> open items, all branches, kept excluded
set -euo pipefail

usage() {
  {
    echo "usage: followup [-C DIR] add TEXT [--source S]"
    echo "       followup [-C DIR] list [--open] [--all] [--orphaned]"
    echo "       followup [-C DIR] list --kept"
    echo "       followup [-C DIR] done N --as now|dropped|ticket REF"
    echo "       followup [-C DIR] keep N"
    echo "       followup [-C DIR] count"
  } >&2
  exit 2
}

die() {
  echo "followup: $*" >&2
  exit 1
}

# single_line WHAT VALUE -> refuse an empty or multi-line field: each item is
# exactly one line of the file
single_line() {
  [ -n "$2" ] || die "$1 must not be empty"
  case "$2" in
    *$'\n'* | *$'\r'*) die "$1 must be a single line" ;;
  esac
}

# --- shared helpers ---

# Sets LIST (the list file) and DIR (its .superpowers directory) for the
# repository the current directory belongs to.
resolve_list() {
  local common main said
  if ! common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    said=$(git rev-parse --git-common-dir 2>&1 >/dev/null) || true
    die "not inside a git work tree ($PWD): ${said%%$'\n'*}"
  fi
  [ "$(basename "$common")" = .git ] \
    || die "cannot locate the main checkout: git common dir $common is not a .git directory"
  main=$(dirname "$common")
  DIR="$main/.superpowers"
  LIST="$DIR/followups.md"
}

# current_branch -> the short name of the checked-out branch; refuses on a
# detached HEAD, which has no branch to tag an item with
current_branch() {
  local ref
  # Strip refs/heads/ by hand: --short prints heads/X when a tag is also
  # named X, which would split one branch's items across two tags.
  ref=$(git symbolic-ref -q HEAD) \
    || die "detached HEAD: check out a branch to tag follow-ups with"
  printf '%s\n' "${ref#refs/heads/}"
}

ensure_dir() {
  mkdir -p "$DIR"
  [ -e "$DIR/.gitignore" ] || printf '*\n' >"$DIR/.gitignore"
}

# max_number -> the largest item number in the list, 0 when none
max_number() {
  if [ -f "$LIST" ]; then
    awk '/^- \[[ x]\] [0-9]+\. / { n = substr($0, 7) + 0; if (n > max) max = n }
         END { print max + 0 }' "$LIST"
  else
    echo 0
  fi
}

# --- ops ---

op_add() {
  local text="" source="" branch n line
  [ $# -ge 1 ] || usage
  text=$1
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --source)
        [ $# -ge 2 ] || usage
        source=$2
        single_line "source" "$source"
        shift 2
        ;;
      *) usage ;;
    esac
  done
  single_line "follow-up text" "$text"
  resolve_list
  branch=$(current_branch)
  ensure_dir
  n=$(($(max_number) + 1))
  line="- [ ] $n. [$branch] $text"
  [ -z "$source" ] || line="$line ($source)"
  # A hand-edited list may lack its final newline; appending straight after
  # it would merge two items into one line.
  if [ -s "$LIST" ] && [ -n "$(tail -c 1 "$LIST")" ]; then
    printf '\n' >>"$LIST"
  fi
  printf '%s\n' "$line" >>"$LIST"
  printf '%s\n' "$n"
}

op_list() {
  local open=false all=false orphaned=false kept=false branch="" live=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kept) kept=true ;;
      --open) open=true ;;
      --all) all=true ;;
      --orphaned) orphaned=true ;;
      *) usage ;;
    esac
    shift
  done
  resolve_list
  # --kept stands alone: open items tagged [*], on any branch.
  if [ "$kept" = true ]; then
    [ "$all" = false ] && [ "$orphaned" = false ] || usage
    [ -f "$LIST" ] || return 0
    awk 'substr($0, 1, 6) == "- [ ] " && /^- \[ \] [0-9]+\. \[\*\] /' "$LIST"
    return 0
  fi
  [ "$all" = true ] || branch=$(current_branch)
  [ -f "$LIST" ] || return 0
  # Local branch names, one per line, for --orphaned. Strip refs/heads/ by
  # hand for the same reason as current_branch.
  if [ "$orphaned" = true ]; then
    live=$(git for-each-ref --format='%(refname)' refs/heads/ | sed 's|^refs/heads/||')
  fi
  # Match on the exact "] [branch] " tag after the number, so branch feat
  # never shows feat-x's items and text cannot fake a tag.
  # Values go to awk through the environment: awk -v would expand
  # backslash escapes in them.
  # A tag runs to the first "] ": git refuses spaces in branch names.
  OPEN=$open BRANCH=$branch ORPHANED=$orphaned LIVE=$live awk '
    BEGIN {
      open = ENVIRON["OPEN"]; branch = ENVIRON["BRANCH"]
      orphaned = ENVIRON["ORPHANED"]
      n = split(ENVIRON["LIVE"], names, "\n")
      for (i = 1; i <= n; i++) if (names[i] != "") alive[names[i]] = 1
    }
    !/^- \[[ x]\] [0-9]+\. \[/ { next }
    open == "true" && substr($0, 1, 6) != "- [ ] " { next }
    branch != "" {
      rest = substr($0, 7); sub(/^[0-9]+\. /, "", rest)
      tag = "[" branch "] "
      if (substr(rest, 1, length(tag)) != tag) {
        if (orphaned != "true") next
        end = index(rest, "] ")
        if (end < 3 || substr(rest, 2, end - 2) == "*" || (substr(rest, 2, end - 2) in alive)) next
      }
    }
    { print }
  ' "$LIST"
}

op_done() {
  local n disposition tmp state
  [ $# -ge 3 ] && [ "$2" = "--as" ] || usage
  n=$1
  case "$3" in
    now | dropped)
      [ $# -eq 3 ] || usage
      disposition=$3
      ;;
    ticket)
      [ $# -eq 4 ] || usage
      disposition=$4
      single_line "ticket ref" "$disposition"
      ;;
    *) usage ;;
  esac
  case "$n" in
    '' | *[!0-9]* | 0*) die "bad follow-up number: $n" ;;
  esac
  resolve_list
  state=none
  [ ! -f "$LIST" ] || state=$(N="$n. " awk '
    BEGIN { n = ENVIRON["N"] }
    substr($0, 7, length(n)) == n && substr($0, 1, 6) == "- [ ] " { s = "open" }
    substr($0, 7, length(n)) == n && substr($0, 1, 6) == "- [x] " { s = "closed" }
    END { print s ? s : "none" }' "$LIST")
  case "$state" in
    none) die "no follow-up $n" ;;
    closed) die "follow-up $n is already closed" ;;
  esac
  # Temp file beside the list, then mv: an interrupted rewrite never leaves
  # a torn list behind.
  tmp=$(mktemp "$DIR/.followups.XXXXXX")
  P="- [ ] $n. " D=$disposition awk '
    BEGIN { p = ENVIRON["P"]; d = ENVIRON["D"] }
    index($0, p) == 1 { $0 = "- [x] " substr($0, 7) " → " d }
    { print }
  ' "$LIST" >"$tmp" && mv "$tmp" "$LIST" || { rm -f "$tmp"; die "could not rewrite $LIST"; }
}

op_keep() {
  local n state tmp
  [ $# -eq 1 ] || usage
  n=$1
  case "$n" in
    '' | *[!0-9]* | 0*) die "bad follow-up number: $n" ;;
  esac
  resolve_list
  state=none
  [ ! -f "$LIST" ] || state=$(N="$n. " awk '
    BEGIN { n = ENVIRON["N"] }
    substr($0, 7, length(n)) == n && substr($0, 1, 6) == "- [ ] " {
      rest = substr($0, 7 + length(n))
      if (substr(rest, 1, 4) == "[*] ") s = "kept"
      else if (substr(rest, 1, 1) == "[" && index(rest, "] ") > 2) s = "open"
      else s = "untagged"
    }
    substr($0, 7, length(n)) == n && substr($0, 1, 6) == "- [x] " { s = "closed" }
    END { print s ? s : "none" }' "$LIST")
  case "$state" in
    none) die "no follow-up $n" ;;
    closed) die "follow-up $n is already closed" ;;
    kept) die "follow-up $n is already kept" ;;
    untagged) die "follow-up $n has no branch tag" ;;
  esac
  tmp=$(mktemp "$DIR/.followups.XXXXXX")
  P="- [ ] $n. " awk '
    BEGIN { p = ENVIRON["P"] }
    index($0, p) == 1 {
      rest = substr($0, length(p) + 1)
      end = index(rest, "] ")
      $0 = p "[*] " substr(rest, end + 2)
    }
    { print }
  ' "$LIST" >"$tmp" && mv "$tmp" "$LIST" || { rm -f "$tmp"; die "could not rewrite $LIST"; }
}

op_count() {
  [ $# -eq 0 ] || usage
  resolve_list
  if [ -f "$LIST" ]; then
    awk '/^- \[ \] [0-9]+\. / && !/^- \[ \] [0-9]+\. \[\*\] / { n++ } END { print n + 0 }' "$LIST"
  else
    echo 0
  fi
}

# --- dispatch ---

if [ "${1:-}" = "-C" ]; then
  [ -d "${2:-}" ] || { echo "bad -C directory: ${2:-}" >&2; exit 2; }
  cd "$2"
  shift 2
fi

[ $# -ge 1 ] || usage
op=$1
shift
case "$op" in
  add) op_add "$@" ;;
  list) op_list "$@" ;;
  done) op_done "$@" ;;
  keep) op_keep "$@" ;;
  count) op_count "$@" ;;
  *) usage ;;
esac
