{
  "schemaVersion": 1,
  "name": "stateful-superpowers",
  "displayName": "Stateful Superpowers",
  "version": "0.10.0",
  "description": "Stateful skills library for Claude Code: a self-driving brainstorm → plan → TDD → review workflow that remembers your project's language and key decisions across sessions. Based on Superpowers by Jesse Vincent and Matt Pocock's engineering skills.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "brainstorming",
        "path": "skills/brainstorming/SKILL.md"
      },
      {
        "id": "commenting-modules",
        "path": "skills/commenting-modules/SKILL.md"
      },
      {
        "id": "designing-modules",
        "path": "skills/designing-modules/SKILL.md"
      },
      {
        "id": "diagnosing-superpowers",
        "path": "skills/diagnosing-superpowers/SKILL.md"
      },
      {
        "id": "dispatching-parallel-agents",
        "path": "skills/dispatching-parallel-agents/SKILL.md"
      },
      {
        "id": "executing-plans",
        "path": "skills/executing-plans/SKILL.md"
      },
      {
        "id": "finishing-a-development-branch",
        "path": "skills/finishing-a-development-branch/SKILL.md"
      },
      {
        "id": "grilling",
        "path": "skills/grilling/SKILL.md"
      },
      {
        "id": "handoff",
        "path": "skills/handoff/SKILL.md"
      },
      {
        "id": "improving-architecture",
        "path": "skills/improving-architecture/SKILL.md"
      },
      {
        "id": "receiving-code-review",
        "path": "skills/receiving-code-review/SKILL.md"
      },
      {
        "id": "requesting-code-review",
        "path": "skills/requesting-code-review/SKILL.md"
      },
      {
        "id": "subagent-driven-development",
        "path": "skills/subagent-driven-development/SKILL.md"
      },
      {
        "id": "syncing-context",
        "path": "skills/syncing-context/SKILL.md"
      },
      {
        "id": "systematic-debugging",
        "path": "skills/systematic-debugging/SKILL.md"
      },
      {
        "id": "test-driven-development",
        "path": "skills/test-driven-development/SKILL.md"
      },
      {
        "id": "using-git-worktrees",
        "path": "skills/using-git-worktrees/SKILL.md"
      },
      {
        "id": "using-superpowers",
        "path": "skills/using-superpowers/SKILL.md"
      },
      {
        "id": "verification-before-completion",
        "path": "skills/verification-before-completion/SKILL.md"
      },
      {
        "id": "writing-plans",
        "path": "skills/writing-plans/SKILL.md"
      },
      {
        "id": "writing-skills",
        "path": "skills/writing-skills/SKILL.md"
      },
      {
        "id": "zoom-out",
        "path": "skills/zoom-out/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "bash",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
